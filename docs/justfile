# Recipes for the TanStack Start website. Run from the repo root as
# `just docs::<recipe>`, or from this directory as `just <recipe>`.

[private]
default:
    @just --list

# Build the site (the pnpm script copies the schema into public/ first)
build:
    pnpm run build

# Start the dev server (the pnpm script copies the schema into public/ first)
dev:
    pnpm run dev

# Type-check the website package
typecheck:
    pnpm run typecheck

# Preview the production build locally
preview:
    pnpm run preview
