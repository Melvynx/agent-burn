{
	"$schema": "https://unpkg.com/oxlint/configuration_schema.json",
	"ignorePatterns": [
		"dist",
		"target",
		"node_modules",
		"coverage",
		".git",
		".claude/settings.local.json",
		"nix/models-dev-gen.ts",
		"docs/src/routeTree.gen.ts",
		"docs/.output",
		"docs/.tanstack",
		"docs/.source",
		"docs/.vercel"
	],
	"options": {
		"typeAware": true,
		"typeCheck": true
	}
}
